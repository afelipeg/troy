---
import { getImage } from "astro:assets";
import desktopScreenshot from "../assets/app-desktop-troy.webp";
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
import AuditOverview from "../components/AuditOverview.astro";
import HowItWorks from "../components/HowItWorks.astro";

const PROJECT_REPOSITORY_URL = "https://github.com/afelipeg/troy";

const screenshot = await getImage({
  src: desktopScreenshot,
  widths: [864, 1180, 1728, 2360],
  format: "webp",
  quality: 90,
});

---

<Layout>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-float" aria-hidden="true">
      {[
        { key: "opencode", icon: "/harnesses/opencode-dark.svg", cls: "hf-opencode" },
        { key: "antigravity", icon: "/harnesses/antigravity.svg", cls: "hf-antigravity" },
        { key: "claude", icon: "/harnesses/claude-ai-icon.svg", cls: "hf-claude" },
        { key: "codex", icon: "/harnesses/openai_dark.svg", cls: "hf-codex" },
        { key: "grok", icon: "/harnesses/grok-dark.svg", cls: "hf-grok" },
        { key: "cursor", icon: "/harnesses/cursor_light.svg", cls: "hf-cursor" },
      ].map((m) => (
        <span class:list={["hero-float-mark", m.cls]}>
          <span class="hero-float-card"><img src={m.icon} alt="" /></span>
        </span>
      ))}
    </div>

    <div class="container hero-inner">
      <h1 class="hero-title display">
        <span data-rise>Agentic AI security,</span><br /><span data-rise style="--d:90ms">built for</span><br /><span data-rise style="--d:180ms">the harness.</span>
      </h1>
      <p class="hero-sub" data-rise style="--d:300ms">
        Inspect how your agents connect to tools, MCP servers, files, memory, and APIs.
        Find risks with evidence and review fixes from a developer console.
      </p>
      <div class="hero-actions" data-rise style="--d:400ms">
        <a href={PROJECT_REPOSITORY_URL} class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          <span>View project on GitHub</span>
        </a>
      </div>

      <!-- The rise wrapper is separate so its animated transform does not override the preview tilt. -->
      <div data-rise style="--d:520ms">
        <div class="hero-preview">
          <figure class="hero-screenshot-frame">
            <picture>
              <!-- Match the hidden mobile layout without requesting a screenshot. -->
              <source
                media="(max-width: 820px)"
                srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
              />
              <img
                src={desktopScreenshot.src}
                srcset={`${screenshot.srcSet.attribute}, ${desktopScreenshot.src} ${desktopScreenshot.width}w`}
                sizes="(max-width: 960px) min(864px, calc(100vw - 20px)), min(1180px, calc(100vw - 60px))"
                alt="Troy showing a harness risk review in a thread, with the project panel open"
                width={desktopScreenshot.width}
                height={desktopScreenshot.height}
                loading="eager"
                decoding="async"
              />
            </picture>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="sec-how">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">How it works</div>
        <h2>From finding to fix</h2>
      </div>
      <HowItWorks />
    </div>
  </section>

  <section id="analyzes" class="sec-analyzes">
    <div class="container analyzes-inner">
      <div class="section-head" style="margin-bottom:0">
        <div class="eyebrow">What it analyzes</div>
        <h2>Your agents' attack surface</h2>
        <p>Coverage depends on the files it can access and the rules available.</p>
      </div>
      <ul class="checklist analyzes-list">
        <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Instructions and skills.</li>
        <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> MCP servers and tools.</li>
        <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Permissions and credential references.</li>
        <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> CI/CD workflows that run agents.</li>
        <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Identifiable connections to APIs, files, and memory.</li>
      </ul>
    </div>
  </section>

  <section id="audit-overview" class="sec-audit">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Audit overview</div>
        <h2>See what changed between audits</h2>
        <p>
          Each audit is a snapshot of the files you point it at. Compare runs to see
          which findings the rules no longer detect and what is still open.
        </p>
      </div>
      <AuditOverview />
    </div>
  </section>

  <section id="harnesses" class="sec-harness">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Developer experience</div>
        <h2>A code console with harness security built in</h2>
        <p>
          Work with supported agents, the terminal, files, diffs, and Git in the
          T3 Code experience. Review fixes before you apply them.
        </p>
      </div>

      <div class="harness-grid">
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/claude-ai-icon.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Claude Code</div>
            <div class="harness-tag">claude auth login</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/openai_dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Codex CLI</div>
            <div class="harness-tag">codex login</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/opencode-dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">OpenCode</div>
            <div class="harness-tag">opencode auth</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/cursor_light.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Cursor</div>
            <div class="harness-tag">@cursor/sdk</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/grok-dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Grok CLI</div>
            <div class="harness-tag">grok login</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/antigravity.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Antigravity</div>
            <div class="harness-tag">Google sign-in</div>
          </div>
        </div>
      </div>

      <div class="harness-footer">
        <div class="harness-footer-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> No keys resold. No quota caps.</div>
        <div class="harness-footer-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Switch models mid-thread.</div>
        <div class="harness-footer-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Review fixes before you apply them.</div>
      </div>
    </div>
  </section>

  <section id="git" class="sec-git">
    <div class="container git-inner">
      <div
        class="git-visual"
        role="img"
        aria-label="Illustration of the T3 Code Git workflow: review a diff, commit and push changes, and open a pull request."
      >
        <div class="pr-card tile">
          <div class="pr-head">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M18 8v5a3 3 0 01-3 3h-3M13 13l-2 3 2 3"/></svg>
            <span class="pr-title">Add marketing hero animation</span>
            <span class="pr-status">Ready</span>
          </div>
          <div class="pr-meta">
            <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M6 12a6 6 0 006-6h6"/></svg> feat/marketing-hero → main</span>
            <span>+142 −38</span>
            <span>3 commits</span>
          </div>
          <div class="pr-files">
            <div><code>apps/marketing/src/pages/index.astro</code> <span>+14 −2</span></div>
            <div><code>apps/marketing/src/layouts/Layout.astro</code> <span>+8 −0</span></div>
            <div><code>apps/marketing/public/hero.css</code> <span>+120 −36</span></div>
          </div>
          <div class="pr-foot">
            <span class="btn btn-ghost" style="font-size:12px;padding:6px 10px">View diff</span>
            <span class="btn btn-primary" style="font-size:12px;padding:6px 12px">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
              Open pull request
            </span>
          </div>
        </div>
        <div class="pr-trail">
          <div class="pr-trail-dot"></div>
          <div class="pr-trail-line"></div>
          <div class="pr-trail-dot"></div>
        </div>
        <div class="pr-button-shell">
          <span class="pr-button">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M18 8v5a3 3 0 01-3 3h-3M13 13l-2 3 2 3"/></svg>
            Commit &amp; push
            <span id="pr-button-kbd" class="pr-button-kbd">⌘⏎</span>
          </span>
        </div>
      </div>

      <div class="git-copy">
        <div class="section-head" style="margin-bottom:0">
          <h2>One button to commit, push, and make a PR.</h2>
          <p>
            Every agent thread writes to its own branch. When it's good, one
            button opens the PR on GitHub with a generated title, body and
            changelog. No terminal dance required.
          </p>
          <ul class="checklist" style="margin-top:24px">
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Auto-generated PR titles &amp; bodies</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Inline diff review before you push</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Draft PRs, stack PRs, amend PRs</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Works with your existing GitHub auth</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="privacy" class="sec-privacy">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Privacy and limits</div>
        <h2>What runs where</h2>
      </div>
      <div class="privacy-grid">
        <div class="tile privacy-tile">
          <div class="eyebrow">Privacy</div>
          <p>
            Analysis runs locally. Content sent to the agent is processed by the AI
            provider you connect. The app may make other connections depending on its
            configuration.
          </p>
        </div>
        <div class="tile privacy-tile privacy-tile--limits">
          <div class="eyebrow">Limits</div>
          <p>
            The inspector performs static analysis and AI-assisted review. It is not a
            sandbox, it does not block actions in real time, and it does not guarantee
            it will find every vulnerability.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="open" class="sec-open">
    <div class="container">
      <div class="section-head open-head">
        <div class="eyebrow">Open source</div>
        <h2>Built on T3 Code</h2>
        <p>
          This project is a fork of <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">T3 Code</a>.
          It keeps its MIT license and the corresponding attribution.
        </p>
      </div>

      <div class="open-grid">
        <div class="tile open-term">
          <div class="open-term-head">
            <span></span><span></span><span></span>
            <span class="open-term-title">~/code</span>
          </div>
          <div class="open-term-body">
            <div><span class="prompt">$</span> gh repo clone afelipeg/troy</div>
            <div class="dim">✓ Cloned troy into ./troy</div>
            <div><span class="prompt">$</span> cd troy &amp;&amp; vp install</div>
            <div class="dim">✓ 1 284 packages installed in 4.2s</div>
            <div><span class="prompt">$</span> vp run dev</div>
            <div class="dim">▲ T3 Code dev server → <span class="accent">http://localhost:4001</span></div>
            <div class="cursor"><span class="prompt">$</span><span class="caret"></span></div>
          </div>
        </div>

        <div class="tile open-pitch">
          <div class="open-pitch-copy">
            <ul class="open-pitch-list">
              <li>
                <span class="open-pitch-mark" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span><strong>Change the UI.</strong> Restyle every surface to match your taste.</span>
              </li>
              <li>
                <span class="open-pitch-mark" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span><strong>Add an agent.</strong> Wire in your own tools, models, and flows.</span>
              </li>
              <li>
                <span class="open-pitch-mark" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span><strong>Ship your own build.</strong> Self-host it or distribute it as your own.</span>
              </li>
            </ul>
          </div>

          <div class="open-pitch-footer">
            <div class="open-pitch-meta">
              <span>MIT licensed</span>
              <span aria-hidden="true">·</span>
              <span>Fork of T3 Code</span>
            </div>

            <div class="open-pitch-actions">
              <a class="btn btn-primary" href={PROJECT_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
                Explore the code
              </a>
              <a class="open-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
                T3 Code upstream
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="download" class="sec-cta">
    <div class="container cta-inner">
      <div class="eyebrow">Download</div>
      <h2 class="display cta-title">
        Available for macOS
      </h2>
      <p class="cta-sub">
        Connect a supported agent and select the project you want to inspect.
      </p>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href={PROJECT_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          View project on GitHub
        </a>
      </div>
      <p class="cta-note">
        During the pilot, if the app is not signed and notarized, macOS may show a security warning.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { startHomeMotion } from "../lib/homeMotion";

  const kbd = document.getElementById("pr-button-kbd");
  if (kbd && !/Mac/i.test(navigator.userAgent)) kbd.textContent = "Ctrl ⏎";

  const hero = document.querySelector<HTMLElement>(".hero");
  const field = document.querySelector<HTMLElement>(".hero-float");
  const caret = document.querySelector<HTMLElement>(".caret");
  if (hero && field && caret) {
    startHomeMotion({ hero, field, tracks: [], caret });
  }
</script>

<style>
  .sec-analyzes .analyzes-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .analyzes-list li {
    font-size: 17px;
  }

  .privacy-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .privacy-tile {
    padding: 28px;
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .privacy-tile p {
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.55;
  }

  .privacy-tile--limits {
    border-color: color-mix(in oklch, var(--warn) 40%, transparent);
  }

  .open-head p a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cta-note {
    margin-top: 20px;
    color: var(--fg-dim);
    font-size: 14px;
  }

  @media (max-width: 820px) {
    .sec-analyzes .analyzes-inner,
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }

  section {
    position: relative;
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .section-head {
    margin-bottom: 56px;
    max-width: 720px;
  }

  .section-head .eyebrow {
    margin-bottom: 14px;
    display: block;
  }

  .section-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .checklist li svg {
    color: var(--ok);
    flex-shrink: 0;
  }

  .hero {
    padding: 72px 0 60px;
    position: relative;
    overflow: hidden;
    border-top: 0;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
  }

  .hero-inner {
    position: relative;
    text-align: center;
  }

  .hero-title {
    font-size: clamp(38px, 5.6vw, 76px);
    margin: 48px auto 22px;
    max-width: 20ch;
    text-wrap: balance;
  }
