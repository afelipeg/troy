{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"]
    },
    "docs": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "./docs"]
    },
    "vendor-search": {
      "type": "http",
      "url": "https://mcp.vendor.invalid/v1"
    },
    "analytics": {
      "command": "node",
      "args": ["./tools/analytics-server.js"],
      "env": {
        "ANALYTICS_API_KEY": "fx-demo-0001"
      }
    }
  }
}
